-- One row per library entry, with the numbers the library screen sorts and
-- filters on.
--
-- Those numbers used to be a GROUP BY over the whole chapters table, joined to
-- history, recomputed on every emission of the library flow -- which is every
-- write to mangas, chapters or history, page reads included. They are read off
-- manga_progress instead, where the staleness triggers and recalculateForManga
-- keep them up to date. The join is on the primary key, so the cost is now
-- linear in library entries rather than in chapters.
--
-- A manga with no row yet reads as zero, which is what a manga with no chapters
-- is worth anyway. A row flagged is_stale reads as its previous value until
-- MangaProgressMaintainer recalculates it, a window of one recalculation pass.
CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(P.total_chapter_count, 0) AS totalCount,
    coalesce(P.read_chapter_count, 0) AS readCount,
    coalesce(P.latest_upload_at, 0) AS latestUpload,
    coalesce(P.latest_fetch_at, 0) AS chapterFetchedAt,
    coalesce(P.last_read_at, 0) AS lastRead,
    coalesce(P.bookmarked_chapter_count, 0) AS bookmarkCount,
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN manga_progress P
ON P.manga_id = M._id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite_at IS NOT NULL;

library:
SELECT *
FROM libraryView;
